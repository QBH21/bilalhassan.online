# Cloudflare reads this file; other hosts ignore it.
# Files in /assets keep for 30 days, so a changed image needs a new file name (or a new ?v=) to reach visitors sooner.
/assets/*
  Cache-Control: public, max-age=2592000
/assets/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Security headers for every page and file. Scripts only run from this site or from an inline <script>
# whose hash is listed in the CSP (tools/sync.mjs writes that list), and Trusted Types stops scripts from
# turning strings into HTML: together they close the usual doors for cross-site scripting.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: SAMEORIGIN
